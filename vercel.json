{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "structured.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/course/(.*)", "destination": "/api/index.js" },
    { "source": "/file", "destination": "/api/index.js" }
  ]
}
